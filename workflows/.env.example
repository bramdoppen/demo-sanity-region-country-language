# Rehearsal only: with no SANITY_CONTEXT_TOKEN, classify against the FAQs + legacy page directly.
# Ignored as soon as SANITY_CONTEXT_TOKEN is set.
KB_REHEARSAL=false
# Demo knob: first French pass is written off-brand so the brand check flags it.
DEMO_FLAG_FIRST_FR=true
