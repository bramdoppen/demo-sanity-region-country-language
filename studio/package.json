{
  "name": "studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "sanity"
  ],
  "license": "UNLICENSED",
  "main": "package.json",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "predev": "npm run sanity:typegen",
    "dev": "sanity dev",
    "sanity:typegen": "sanity schema extract --enforce-required-fields --force --path ../sanity.schema.json && sanity typegen generate",
    "schema:deploy": "sanity schema deploy",
    "start": "sanity start",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@sanity/assist": "^6.2.5",
    "@sanity/document-internationalization": "^6.2.44",
    "@sanity/icons": "^5.2.3",
    "@sanity/language-filter": "^5.0.23",
    "@sanity/sdk": "^3.9.1",
    "@sanity/ui": "^4.4.10",
    "@sanity/vision": "^6.20.0",
    "@sanity/workflow-components": "0.37.0",
    "@sanity/workflow-diagram": "0.37.0",
    "@sanity/workflow-engine": "0.37.0",
    "@sanity/workflow-react": "0.37.0",
    "@sanity/workflow-sdk": "0.37.0",
    "@sanity/workflow-studio": "0.37.0",
    "@sanity/workflow-studio-plugin": "0.37.0",
    "date-fns": "^4.1.0",
    "pluralize-esm": "^9.0.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "sanity": "^6.20.0",
    "sanity-plugin-asset-source-unsplash": "^7.0.30",
    "sanity-plugin-internationalized-array": "^5.3.7",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7.0.0",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
