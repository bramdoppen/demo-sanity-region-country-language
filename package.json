{
  "name": "demo-sanity-region-country-language",
  "private": true,
  "workspaces": [
    "studio",
    "frontend",
    "workflows",
    "question-desk",
    "functions/*"
  ],
  "scripts": {
    "dev": "npx run-p --print-label dev:*",
    "dev:next": "npm run dev --workspace=frontend",
    "dev:studio": "npm run dev --workspace=studio",
    "dev:desk": "npm run dev --workspace=question-desk",
    "format": "prettier --cache --write .",
    "import-sample-data": "cd studio && sanity dataset import sample-data.tar.gz --dataset production --replace",
    "lint": "npm run lint --workspace=frontend",
    "type-check": "npm run type-check --workspaces --if-present",
    "seed": "npm run seed --workspace=workflows",
    "reset": "npm run reset --workspace=workflows",
    "translate": "npm run translate --workspace=workflows --",
    "wf:deploy": "npm run wf:deploy --workspace=workflows",
    "drain": "npm run drain --workspace=workflows --",
    "ask": "npm run ask --workspace=workflows --",
    "kb:ask": "npm run kb:ask --workspace=workflows --",
    "localize": "npm run localize -w workflows --",
    "insights": "npm run insights --workspace=workflows"
  },
  "overrides": {
    "@sanity/sdk": {
      "@sanity/mutate": "0.18.2"
    },
    "@sanity/workflow-cli": "0.37.0",
    "@sanity/workflow-engine": "0.37.0",
    "@sanity/workflow-blueprint": "0.37.0"
  },
  "prettier": "@sanity/prettier-config",
  "devDependencies": {
    "@sanity/prettier-config": "^2.0.3",
    "npm-run-all2": "^5.0.2",
    "prettier": "^3.8.1",
    "@sanity/blueprints": "^0.28.0"
  }
}
